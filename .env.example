# Copy to .env, or just run: python setup_env.py
ADMIN_USER='name@student.gitam.edu'
ADMIN_PASSWORD_HASH='generated-by-setup_env.py'
SECRET_KEY='generated-by-setup_env.py'
EMAILJS_SERVICE_ID=''
EMAILJS_TEMPLATE_ID=''
EMAILJS_PUBLIC_KEY=''
COOKIE_SECURE='0'
# Set DATABASE_URL to a PostgreSQL URL for persistent hosted data. Without it,
# the app uses the local SQLite database for development.
DATABASE_URL=''
# Set BLOB_READ_WRITE_TOKEN for local Vercel Blob uploads. On Vercel, connect
# a Blob store to the project to use managed OIDC credentials instead.
BLOB_READ_WRITE_TOKEN=''
